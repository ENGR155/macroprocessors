# Proposed explicit jumper wiring. iCE40 SG48 package pad numbers, NOT header positions.
# Verify against your assembled E155 board before programming; all bridge switches OPEN.
set_io mcu_sck 23
set_io mcu_cs_n 25
set_io mcu_mosi 26
set_io mcu_miso 27
set_io permit 34
set_io fault_n 43
set_io pwm 36
set_io gate_enable 42
set_io sample_debug 38
